# Module 0 API
GREENLEDGER_FARM_API=http://127.0.0.1:8000

# Optional: process a single farm manually
GREENLEDGER_FARM_ID=

# Copernicus Data Space OAuth client
CDSE_CLIENT_ID=YOUR_CLIENT_ID
CDSE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Observation policy
S2_MAX_CLOUD_COVER=20
S2_CHECK_INTERVAL_HOURS=24
S2_RESOLUTION_M=10

# Storage
GREENLEDGER_OBSERVATION_DIR=data/observations

# Existing SAM checkpoint
SAM_CHECKPOINT=models/sam_vit_h_4b8939.pth

# SILVIA output directory
SILVIA_OUTPUT_DIR=data/silvia_results
SILVIA_INPUT_DIR=data/input

# Sentinel-2 retrieval quality/context
S2_MIN_IMAGE_PIXELS=64
S2_INITIAL_LOOKBACK_DAYS=90
S2_MAX_CLOUD_COVER=20
